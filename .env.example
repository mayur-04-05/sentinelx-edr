# ==================================================================
# SENTINELX EDR — SYSTEM CONFIGURATION
# ==================================================================

# 1. DATABASE CONFIGURATION
# Primary database is PostgreSQL (Docker). SQLite is used for local tests.
DATABASE_URL=sqlite:///C:/Users/Mayur/.gemini/antigravity/scratch/sentinelx-edr/sentinelx.db
# PostgreSQL Docker example:
# DATABASE_URL=postgresql://sentinelx:sentinelxpassword123@db:5432/sentinelx

# 2. JWT SECURITY KEY
# Change in production environments to a secure random string
JWT_SECRET=supersecretkeychangeinproduction1234567890

# 3. AI CO-PILOT CONFIGURATION
# AI_PROVIDER options: "openai", "ollama", or "none" (local deterministic parser)
AI_PROVIDER=none
AI_API_KEY=

# Ollama local models settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# 4. ENDPOINT AGENT TIMERS (In Seconds)
HEARTBEAT_INTERVAL=15.0
TELEMETRY_INTERVAL=5.0
